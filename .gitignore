# Windows resource embedding
rsrc_windows_*.syso

# Generated QuickJS headers for spider ModuleLoader CGO
internal/spider/qjsinc/

# Android arm64 Go engine (built by scripts/build-engine-flutter.sh android)
flutter/android/app/src/main/jniLibs/**/*.so
flutter/assets/engine/libkotv_engine.so
# 引擎二进制按平台打包时生成，勿入库（否则 Win 会打进 mac/linux 的 kotv-engine）
flutter/assets/engine/kotv-engine
flutter/assets/engine/kotv-engine.exe

# 开源内嵌字体（0.1.0 美化后全平台内置 NotoSansSC/emoji，随主线上传；
# Win7 线 fetch-flutter-fonts.sh 检测文件已存在会跳过下载，无需再忽略）
# flutter/assets/fonts/*.otf
# flutter/assets/fonts/*.ttf
